# Node / TypeScript
# =========================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# =========================
# OS files
# =========================

.DS_Store
Thumbs.db
desktop.ini


# =========================
